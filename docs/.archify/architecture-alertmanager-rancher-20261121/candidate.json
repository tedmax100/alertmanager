  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Routing",
      "items": [
        "Prometheus Server 透過 /api/v2/alerts 周期性推送活躍與恢復告警",
        "Dispatcher 透過 DFS 深度優先遍歷 Route Tree，支援 continue: true 多路廣播",
        "依據 group_by 標籤計算唯一 GroupKey，將告警收斂進專屬 aggrGroup"
      ]
    },
    {
      "dot": "emerald",
      "title": "Timers & Dedup",
      "items": [
        "group_wait 控制新群組聚合緩衝，group_interval 控制增量更新頻率",
        "ClusterWaitStage 依節點哈希順序偏置等待時間，先發者廣播 nflog",
        "DedupStage 比對 nflog 發送紀錄，相同告警集合在 repeat_interval 內自動靜默"
      ]
    },
    {
      "dot": "rose",
      "title": "Rancher Integration",
      "items": [
        "Prometheus Operator 監聽 AlertmanagerConfig CRD 並編譯進 Secret",
        "config-reloader sidecar 偵測 Secret 變更並對 Alertmanager 發起熱重載",
        "業務命名空間支援宣告式 CRD，自動注入 namespace 隔離標籤"
      ]
    }
  ]
}
