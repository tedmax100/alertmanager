  "cards": [
    {
      "dot": "cyan",
      "title": "Prometheus HA 與雙向獨立推送",
      "items": [
        "Prometheus Pod 0 與 Pod 1 分布於不同可用區 (AZ-a / AZ-b)，各自獨立抓取指標並評估告警規則",
        "雙方無須互相通訊，皆獨立向 Alertmanager Mesh Pods 推送相同的活躍告警 (POST :9093 /api/v2/alerts)",
        "即使單一 Prometheus 實例故障或網路分區，告警 pipeline 依然不中斷且無單點故障"
      ]
    },
    {
      "dot": "emerald",
      "title": "Alertmanager Mesh 去重與 Gossip 協議",
      "items": [
        "Mesh Pods 透過 9094 (TCP/UDP) 運行 Memberlist Gossip 協議，即時同步叢集狀態",
        "包含通知日誌 (nflog) 與靜音規則 (Silences) 的全網狀分散式複製",
        "告警到達時，透過 settle-timeout 與 nflog 鎖機制，由主節點發送通知並廣播，從節點自動抑制重複發送"
      ]
    },
    {
      "dot": "violet",
      "title": "Operator 配置驅動與接收端路由",
      "items": [
        "Prometheus Operator 監聽 Alertmanager 及 AlertmanagerConfig CRD，自動生成設定檔 Secret",
        "透過 HTTP POST /-/reload 觸發熱加載，無須重啟 Pod 即可更新路由樹與 Receivers",
        "根據 severity 與 labels 智慧路由至 PagerDuty、Slack、Webhook 及 Email 等接收端"
      ]
    }
  ]
}
